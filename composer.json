{
    "name": "ruhrcoder/rc-qr-checkout",
    "description": "Shopware 6 Plugin — QR-Code auf der Bestellbestätigungs-Seite für mobile Anzeige der Order",
    "type": "shopware-platform-plugin",
    "license": "MIT",
    "version": "2.0.1",
    "authors": [
        {
            "name": "Ruhrcoder (René Schustek)",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=8.2",
        "shopware/core": "~6.7.0 || ~6.8.0",
        "shopware/storefront": "~6.7.0 || ~6.8.0",
        "endroid/qr-code": "^4.8"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0",
        "phpstan/phpstan": "^1.0",
        "friendsofphp/php-cs-fixer": "^3.0"
    },
    "extra": {
        "shopware-plugin-class": "Ruhrcoder\\RcQrCheckOut\\RcQrCheckOut",
        "label": {
            "de-DE": "QR-Code-Checkout",
            "en-GB": "QR Code Checkout"
        },
        "description": {
            "de-DE": "Zeigt einen QR-Code auf der Bestellbestätigungs-Seite zur mobilen Anzeige der Bestellung.",
            "en-GB": "Shows a QR code on the order confirmation page for mobile order display."
        },
        "manufacturerLink": {
            "de-DE": "https://ruhrcoder.de",
            "en-GB": "https://ruhrcoder.de"
        },
        "supportLink": {
            "de-DE": "https://ruhrcoder.de",
            "en-GB": "https://ruhrcoder.de"
        }
    },
    "autoload": {
        "psr-4": {
            "Ruhrcoder\\RcQrCheckOut\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ruhrcoder\\RcQrCheckOut\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "symfony/runtime": true
        },
        "platform": {
            "php": "8.2.0"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "phpstan": "vendor/bin/phpstan analyse --memory-limit=512M",
        "cs-fix": "vendor/bin/php-cs-fixer fix",
        "cs-check": "vendor/bin/php-cs-fixer fix --dry-run --diff",
        "quality": [
            "@cs-check",
            "@phpstan",
            "@test"
        ]
    }
}
