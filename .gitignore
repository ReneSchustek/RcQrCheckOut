# ============================================================
# .gitignore – RcQrCheckOut
# ============================================================

# IDE
.idea/
.vscode/

# Composer / PHP
vendor/
composer.phar

# Build / Cache
var/
.phpunit.cache/
.php-cs-fixer.cache

# Frontend
node_modules/
/src/Resources/app/storefront/dist/
/src/Resources/app/administration/dist/

# OS
.DS_Store
Thumbs.db

# Secrets
.env
.env.local
.env.*.local
!.env.example
secrets.json

# Die Ausnahmeliste des Spurenprüfers gehört ins Repository.
#
# Die globale Ausschlussliste filtert `.ai-trace-ignore` — gedacht war die Kopie, die
# früher in jedem Projekt lag. Sie versteckt aber auch diese eine, die der Prüfer
# tatsächlich liest. Der Fehler fällt nicht auf: Er liest sie aus dem
# Arbeitsverzeichnis, meldet sauber, und man hält die Ausnahme für eingetragen —
# während jeder Klon und jeder Lauf im Fließband ohne sie dasteht. Am 2026-09-07 traf
# das 17 von 22 Erweiterungen.
!.ai-trace-ignore
